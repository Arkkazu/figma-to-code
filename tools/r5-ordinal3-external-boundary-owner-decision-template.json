{
  "version": 1,
  "kind": "p3-r5-ordinal3-external-boundary-owner-decision-template",
  "status": "owner-input-required",
  "effective": false,
  "purpose": "Capture the materially external decisions required before any provider account access, purchase, provisioning, synthetic runtime creation, or P-3 action. This template is not an authorization and must not be treated as a selected topology.",
  "sourceDocuments": [
    {
      "path": "tools/r5-ordinal3-external-verifier-boundary-requirements-draft.md",
      "sha256": "f3a0ea86270038e62278f97f6d2fa4f75b6c85fb103052a16ae56571877688b3"
    },
    {
      "path": "tools/r5-ordinal3-nonattached-output-evidence-validator.mjs",
      "sha256": "87ff3f44ae9dbf5c735ccff4f239824600e9da2e0ea610b1f36fad731def6a23"
    },
    {
      "path": "tools/r5-ordinal3-hyperv-capability-preflight.ps1",
      "sha256": "0a3cb848af0b6eb3106c7fc33d53ec1c5d92057b81fad79bb0f8c7fb67b4dbec"
    }
  ],
  "requiredOwnerDecisions": {
    "externalVerifier": {
      "providerOrOperator": "REQUIRED_UNSET",
      "trustAnchorAndKeyCustody": "REQUIRED_UNSET",
      "dataResidencyAndJurisdiction": "REQUIRED_UNSET",
      "accountAndCostAuthority": "REQUIRED_UNSET"
    },
    "transmitOnlyTransport": {
      "deviceOrIndependentlyAuditedService": "REQUIRED_UNSET",
      "independentAdministrationBoundary": "REQUIRED_UNSET",
      "injectionDenialTestAuthority": "REQUIRED_UNSET"
    },
    "runtimeAndMeasurement": {
      "attesterAndProtectedMeasurementAgentSubstrate": "REQUIRED_UNSET",
      "trustedTimeSource": "REQUIRED_UNSET",
      "allRuntimeInputPlaneClosurePlan": "REQUIRED_UNSET"
    },
    "evidenceAndRetention": {
      "coverageManifestOwnerAndAudit": "REQUIRED_UNSET",
      "metadataRetentionBackupDeletionPolicy": "REQUIRED_UNSET",
      "independentAuditBudgetAndOperator": "REQUIRED_UNSET"
    },
    "scope": {
      "p3FreeSyntheticProbeProvisioning": "REQUIRED_UNSET",
      "explicitlyExcludesP3DeliveryLaunchImplementation": true,
      "p11Authorization": "NOT_AUTHORIZED"
    }
  },
  "noAuthority": {
    "doesNotSelectProvider": true,
    "doesNotAuthorize": [
      "external account access",
      "purchase or subscription",
      "networking change",
      "physical device deployment",
      "VM or sandbox creation",
      "reissue publication",
      "role delivery",
      "role launch",
      "implementation",
      "return check or apply",
      "site or lifecycle mutation",
      "browser or Figma measurement",
      "P-11 change"
    ],
    "p11Authorization": "NOT_AUTHORIZED"
  },
  "acceptanceRule": "A future finalized owner decision must replace every REQUIRED_UNSET value, bind the final selected topology and all source hashes, and separately state the exact authorized P-3-free synthetic action. It must not authorize a P-3 role action unless that action is separately named."
}
